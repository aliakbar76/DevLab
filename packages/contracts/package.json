{
  "name": "@devlab/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@devlab/eslint-config": "workspace:*",
    "@devlab/typescript-config": "workspace:*",
    "eslint": "^9.27.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
