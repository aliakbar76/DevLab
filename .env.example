# Shared local development defaults — copy to `.env` and adjust if needed.
# Never commit real secrets.

NODE_ENV=development

# PostgreSQL (Docker Compose publishes host 5433 → container 5432)
DATABASE_URL=postgresql://devlab:devlab@localhost:5433/devlab?schema=public
TEST_DATABASE_URL=postgresql://devlab:devlab@localhost:5433/devlab_test?schema=public

# API
# Default 4400: on some Windows hosts Hyper-V reserves 3984-4083 (includes 4000).
API_PORT=4400
# demo = local fixture only. Production boot refuses IDENTITY_MODE=demo.
IDENTITY_MODE=demo

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4400
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
